[
  {
    "voice_id": "elf_female_1",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A00045B.ogg",
    "text": "Mae govannen! Might you spare a moment of your time?",
    "audio_file": "en\\elf_female\\elf_female_1.ogg"
  },
  {
    "voice_id": "elf_female_2",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A00045E.ogg",
    "text": "Suilad mellon! Will you stay a moment?",
    "audio_file": "en\\elf_female\\elf_female_2.ogg"
  },
  {
    "voice_id": "elf_female_3",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A000463.ogg",
    "text": "Allow me to speak of my sorrow.",
    "audio_file": "en\\elf_female\\elf_female_3.ogg"
  },
  {
    "voice_id": "elf_female_4",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A00046F.ogg",
    "text": "Praise Elbereth! One who might be of help.",
    "audio_file": "en\\elf_female\\elf_female_4.ogg"
  },
  {
    "voice_id": "elf_female_5",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A001E1D.ogg",
    "text": "Greetings friend, will you lend me your ear?",
    "audio_file": "en\\elf_female\\elf_female_5.ogg"
  },
  {
    "voice_id": "elf_female_6",
    "category": "elf_female",
    "gender": "female",
    "race": "elf",
    "original_file": "0A020DD5.ogg",
    "text": "No, that path leads to ruin.",
    "audio_file": "en\\elf_female\\elf_female_6.ogg"
  },
  {
    "voice_id": "elf_male_1",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A020DD8.ogg",
    "text": "My realm in the north of the wood was in danger, but I was victorious.",
    "audio_file": "en\\elf_male\\elf_male_1.ogg"
  },
  {
    "voice_id": "elf_male_2",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A015DBD.ogg",
    "text": "We stand in silence, while the storm of Isengard grows stronger.",
    "audio_file": "en\\elf_male\\elf_male_2.ogg"
  },
  {
    "voice_id": "elf_male_3",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A01B895.ogg",
    "text": "Can you tell anything from the confused muddle of footprints?",
    "audio_file": "en\\elf_male\\elf_male_3.ogg"
  },
  {
    "voice_id": "elf_male_4",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A014BB6.ogg",
    "text": "If it took only courage to win battles against wizards, this would be done already.",
    "audio_file": "en\\elf_male\\elf_male_4.ogg"
  },
  {
    "voice_id": "elf_male_5",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A01B965.ogg",
    "text": "The orcs that fled the east wall may have passed nearby.",
    "audio_file": "en\\elf_male\\elf_male_5.ogg"
  },
  {
    "voice_id": "elf_male_6",
    "category": "elf_male",
    "gender": "male",
    "race": "elf",
    "original_file": "0A015242.ogg",
    "text": "You run errands for folk long sworn to be the enemies of my people.",
    "audio_file": "en\\elf_male\\elf_male_6.ogg"
  },
  {
    "voice_id": "man_female_1",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A001DCD.ogg",
    "text": "Greetings friend, how may I be of help?",
    "audio_file": "en\\man_female\\man_female_1.ogg"
  },
  {
    "voice_id": "man_female_2",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A000B91.ogg",
    "text": "Quickly, do not linger and tell me what you want!",
    "audio_file": "en\\man_female\\man_female_2.ogg"
  },
  {
    "voice_id": "man_female_3",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A000437.ogg",
    "text": "Will you lend me your ear?",
    "audio_file": "en\\man_female\\man_female_3.ogg"
  },
  {
    "voice_id": "man_female_4",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A000443.ogg",
    "text": "Will you not have the courtesy to hear my tale?",
    "audio_file": "en\\man_female\\man_female_4.ogg"
  },
  {
    "voice_id": "man_female_5",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A000B64.ogg",
    "text": "I am sorry. Did you need something?",
    "audio_file": "en\\man_female\\man_female_5.ogg"
  },
  {
    "voice_id": "man_female_6",
    "category": "man_female",
    "gender": "female",
    "race": "man",
    "original_file": "0A01EE47.ogg",
    "text": "I should have left the city with the others. Too late now.",
    "audio_file": "en\\man_female\\man_female_6.ogg"
  },
  {
    "voice_id": "man_male_1",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A000BA8.ogg",
    "text": "I have truly terrible things to report.",
    "audio_file": "en\\man_male\\man_male_1.ogg"
  },
  {
    "voice_id": "man_male_2",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A000BC9.ogg",
    "text": "Would you have the kindness to speak with me for a moment?",
    "audio_file": "en\\man_male\\man_male_2.ogg"
  },
  {
    "voice_id": "man_male_3",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A000399.ogg",
    "text": "If you come in peace, then you will help us, will you not?",
    "audio_file": "en\\man_male\\man_male_3.ogg"
  },
  {
    "voice_id": "man_male_4",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A0003A5.ogg",
    "text": "If you are here to help, then you are welcome.",
    "audio_file": "en\\man_male\\man_male_4.ogg"
  },
  {
    "voice_id": "man_male_5",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A010078.ogg",
    "text": "You are welcome here, as long as you do not trouble us.",
    "audio_file": "en\\man_male\\man_male_5.ogg"
  },
  {
    "voice_id": "man_male_6",
    "category": "man_male",
    "gender": "male",
    "race": "man",
    "original_file": "0A010141.ogg",
    "text": "We are simple farmers and herdsmen. We have little to offer you.",
    "audio_file": "en\\man_male\\man_male_6.ogg"
  },
  {
    "voice_id": "hobbit_female_1",
    "category": "hobbit_female",
    "gender": "female",
    "race": "hobbit",
    "original_file": "0A0085B9.ogg",
    "text": "I am pleased that you will hear me.",
    "audio_file": "en\\hobbit_female\\hobbit_female_1.ogg"
  },
  {
    "voice_id": "hobbit_female_2",
    "category": "hobbit_female",
    "gender": "female",
    "race": "hobbit",
    "original_file": "0A0085C8.ogg",
    "text": "I do not think we should waste the day!",
    "audio_file": "en\\hobbit_female\\hobbit_female_2.ogg"
  },
  {
    "voice_id": "hobbit_female_3",
    "category": "hobbit_female",
    "gender": "female",
    "race": "hobbit",
    "original_file": "0A0085AA.ogg",
    "text": "The Lumi-folk could use your help.",
    "audio_file": "en\\hobbit_female\\hobbit_female_3.ogg"
  },
  {
    "voice_id": "hobbit_female_4",
    "category": "hobbit_female",
    "gender": "female",
    "race": "hobbit",
    "original_file": "0A000970.ogg",
    "text": "What can I get for you? Do you have any request?",
    "audio_file": "en\\hobbit_female\\hobbit_female_4.ogg"
  },
  {
    "voice_id": "hobbit_female_5",
    "category": "hobbit_female",
    "gender": "female",
    "race": "hobbit",
    "original_file": "0A00088F.ogg",
    "text": "I am sorry, but my thoughts were elsewhere.",
    "audio_file": "en\\hobbit_female\\hobbit_female_5.ogg"
  },
  {
    "voice_id": "hobbit_male_1",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A0004F2.ogg",
    "text": "Could I take a moment of your time?",
    "audio_file": "en\\hobbit_male\\hobbit_male_1.ogg"
  },
  {
    "voice_id": "hobbit_male_2",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A00056E.ogg",
    "text": "Even if of no use, may I speak with you?",
    "audio_file": "en\\hobbit_male\\hobbit_male_2.ogg"
  },
  {
    "voice_id": "hobbit_male_3",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A000565.ogg",
    "text": "I am sorry to trouble you, but will you help me?",
    "audio_file": "en\\hobbit_male\\hobbit_male_3.ogg"
  },
  {
    "voice_id": "hobbit_male_4",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A00056F.ogg",
    "text": "Even if of no use, may I speak with you?",
    "audio_file": "en\\hobbit_male\\hobbit_male_4.ogg"
  },
  {
    "voice_id": "hobbit_male_5",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A000570.ogg",
    "text": "Could I steal a moment of your time?",
    "audio_file": "en\\hobbit_male\\hobbit_male_5.ogg"
  },
  {
    "voice_id": "hobbit_male_6",
    "category": "hobbit_male",
    "gender": "male",
    "race": "hobbit",
    "original_file": "0A000500.ogg",
    "text": "Oh please, do at least hear me!",
    "audio_file": "en\\hobbit_male\\hobbit_male_6.ogg"
  },
  {
    "voice_id": "dwarf_male_1",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A000394.ogg",
    "text": "My people have not given up the fight against the Angmarim.",
    "audio_file": "en\\dwarf_male\\dwarf_male_1.ogg"
  },
  {
    "voice_id": "dwarf_male_2",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A0008D8.ogg",
    "text": "What can I do for you? Do you have any request?",
    "audio_file": "en\\dwarf_male\\dwarf_male_2.ogg"
  },
  {
    "voice_id": "dwarf_male_3",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A000921.ogg",
    "text": "What will it be? Do you have any wish?",
    "audio_file": "en\\dwarf_male\\dwarf_male_3.ogg"
  },
  {
    "voice_id": "dwarf_male_4",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A0085A1.ogg",
    "text": "Terrible things are happening!",
    "audio_file": "en\\dwarf_male\\dwarf_male_4.ogg"
  },
  {
    "voice_id": "dwarf_male_5",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A0085A3.ogg",
    "text": "The hand of the Witch-king reaches from the past for us.",
    "audio_file": "en\\dwarf_male\\dwarf_male_5.ogg"
  },
  {
    "voice_id": "dwarf_male_6",
    "category": "dwarf_male",
    "gender": "male",
    "race": "dwarf",
    "original_file": "0A00DFF8.ogg",
    "text": "You must strike down the enemy to put an end to the terror.",
    "audio_file": "en\\dwarf_male\\dwarf_male_6.ogg"
  },
  {
    "voice_id": "dwarf_female_1",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A0085AC.ogg",
    "text": "Our crafters could well use your aid.",
    "audio_file": "en\\dwarf_female\\dwarf_female_1.ogg"
  },
  {
    "voice_id": "dwarf_female_2",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A0085B2.ogg",
    "text": "Let us not waste the day.",
    "audio_file": "en\\dwarf_female\\dwarf_female_2.ogg"
  },
  {
    "voice_id": "dwarf_female_3",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A0087A8.ogg",
    "text": "From whence came you in this cold winter?",
    "audio_file": "en\\dwarf_female\\dwarf_female_3.ogg"
  },
  {
    "voice_id": "dwarf_female_4",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A021020.ogg",
    "text": "You think the heart of the mountain has been stolen from my brother's tomb?",
    "audio_file": "en\\dwarf_female\\dwarf_female_4.ogg"
  },
  {
    "voice_id": "dwarf_female_5",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A008654.ogg",
    "text": "We will never bow down to the Iron Crown!",
    "audio_file": "en\\dwarf_female\\dwarf_female_5.ogg"
  },
  {
    "voice_id": "dwarf_female_6",
    "category": "dwarf_female",
    "gender": "female",
    "race": "dwarf",
    "original_file": "0A008794.ogg",
    "text": "The breath of the Witch-king blows hard in this place.",
    "audio_file": "en\\dwarf_female\\dwarf_female_6.ogg"
  },
  {
    "voice_id": "orc_1",
    "category": "orc",
    "gender": "male",
    "race": "orc",
    "original_file": "0A013550.ogg",
    "text": "I'll pound you into dust!",
    "audio_file": "en\\orc\\orc_1.ogg"
  },
  {
    "voice_id": "orc_2",
    "category": "orc",
    "gender": "male",
    "race": "orc",
    "original_file": "0A013578.ogg",
    "text": "Now stand still so I can stomp you!",
    "audio_file": "en\\orc\\orc_2.ogg"
  },
  {
    "voice_id": "orc_3",
    "category": "orc",
    "gender": "male",
    "race": "orc",
    "original_file": "0A013070.ogg",
    "text": "Under my banner this fortress now serves the Dark Lord!",
    "audio_file": "en\\orc\\orc_3.ogg"
  },
  {
    "voice_id": "troll_1",
    "category": "troll",
    "gender": "male",
    "race": "troll",
    "original_file": "0A013550.ogg",
    "text": "I'll pound you into dust!",
    "audio_file": "en\\troll\\troll_1.ogg"
  },
  {
    "voice_id": "troll_2",
    "category": "troll",
    "gender": "male",
    "race": "troll",
    "original_file": "0A013578.ogg",
    "text": "Now stand still so I can stomp you!",
    "audio_file": "en\\troll\\troll_2.ogg"
  },
  {
    "voice_id": "ent_1",
    "category": "ent",
    "gender": "neutral",
    "race": "ent",
    "original_file": "0A0085A7.ogg",
    "text": "Ominous voices whisper in the wind of the old forest.",
    "audio_file": "en\\ent\\ent_1.ogg"
  },
  {
    "voice_id": "ent_2",
    "category": "ent",
    "gender": "neutral",
    "race": "ent",
    "original_file": "0A01001E.ogg",
    "text": "Evil things wander through the deep night.",
    "audio_file": "en\\ent\\ent_2.ogg"
  },
  {
    "voice_id": "dead_1",
    "category": "dead",
    "gender": "neutral",
    "race": "dead",
    "original_file": "0A00EE86.ogg",
    "text": "So many tasty morsels, where does one begin?",
    "audio_file": "en\\dead\\dead_1.ogg"
  },
  {
    "voice_id": "dead_2",
    "category": "dead",
    "gender": "neutral",
    "race": "dead",
    "original_file": "0A012C40.ogg",
    "text": "Your life will now come to an end! But at least you may join my army in death!",
    "audio_file": "en\\dead\\dead_2.ogg"
  },
  {
    "voice_id": "dead_3",
    "category": "dead",
    "gender": "neutral",
    "race": "dead",
    "original_file": "0A012D58.ogg",
    "text": "Another fool dies, soon to rise up by my bidding!",
    "audio_file": "en\\dead\\dead_3.ogg"
  },
  {
    "voice_id": "dead_4",
    "category": "dead",
    "gender": "neutral",
    "race": "dead",
    "original_file": "0A012BA8.ogg",
    "text": "Return to the shadows!",
    "audio_file": "en\\dead\\dead_4.ogg"
  },
  {
    "voice_id": "narrator_1",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A0085A0.ogg",
    "text": "This day is well suited for telling tales.",
    "audio_file": "en\\narrator\\narrator_1.ogg"
  },
  {
    "voice_id": "narrator_2",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A013999.ogg",
    "text": "Yet the Men of the Mountains refused to fulfill their oath.",
    "audio_file": "en\\narrator\\narrator_2.ogg"
  },
  {
    "voice_id": "narrator_3",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A01002E.ogg",
    "text": "Sleep escapes me, for the night shadows bring fear.",
    "audio_file": "en\\narrator\\narrator_3.ogg"
  },
  {
    "voice_id": "narrator_4",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A0085A5.ogg",
    "text": "Angmar casts its dark shadow across the land.",
    "audio_file": "en\\narrator\\narrator_4.ogg"
  },
  {
    "voice_id": "narrator_5",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A0085A7.ogg",
    "text": "Ominous voices whisper in the twilight wind.",
    "audio_file": "en\\narrator\\narrator_5.ogg"
  },
  {
    "voice_id": "narrator_6",
    "category": "narrator",
    "gender": "neutral",
    "race": "narrator",
    "original_file": "0A01001E.ogg",
    "text": "Evil things wander through the dark of night.",
    "audio_file": "en\\narrator\\narrator_6.ogg"
  }
]